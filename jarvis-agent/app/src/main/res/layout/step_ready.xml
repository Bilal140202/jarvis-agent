<?xml version="1.0" encoding="utf-8"?>
<!-- Step 2: Ready -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/readyIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@android:drawable/ic_dialog_info"
        android:tint="#6C63FF"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You're All Set!"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/readyStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checking accessibility service..."
        android:textColor="#808080"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnOpenAccessibility2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Accessibility Settings"
        android:backgroundTint="#2A2A4E"
        android:textColor="#E0E0E0"
        android:layout_marginBottom="8dp" />

</LinearLayout>
