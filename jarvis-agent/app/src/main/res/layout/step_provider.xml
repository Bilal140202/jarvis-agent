<?xml version="1.0" encoding="utf-8"?>
<!-- Step 1: AI Provider Setup -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configure AI Provider"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect Jarvis to your preferred LLM API"
        android:textColor="#808080"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <Spinner
        android:id="@+id/providerSpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#6C63FF"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/apiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="API Key"
        android:textColorHint="#808080"
        android:textColor="#E0E0E0"
        android:backgroundTint="#6C63FF"
        android:inputType="textPassword"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/baseUrlInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Base URL (e.g., https://api.openai.com/v1)"
        android:textColorHint="#808080"
        android:textColor="#E0E0E0"
        android:backgroundTint="#6C63FF"
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/modelInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Model (e.g., gpt-4o)"
        android:textColorHint="#808080"
        android:textColor="#E0E0E0"
        android:backgroundTint="#6C63FF"
        android:inputType="text" />

</LinearLayout>
